{
  "name": "@logfox/cli",
  "version": "0.0.1",
  "description": "Logfox CLI for local development logging",
  "main": "./dist/index.js",
  "bin": {
    "logfox": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logfoxai/cli.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "validate": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.997.0",
    "@aws-sdk/client-iam": "3.997.0",
    "@aws-sdk/client-lambda": "3.997.0",
    "@aws-sdk/client-sts": "3.997.0",
    "@inquirer/prompts": "8.3.0",
    "commander": "12.1.0",
    "open": "10.1.0"
  }
}
